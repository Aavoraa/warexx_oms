{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": null,
      "installCommand": "echo 'dependencies are installed by the build command'",
      "buildCommand": "cd frontend && npm ci && npm run build:site",
      "outputDirectory": "frontend/dist/site",
      "rewrites": [
        {
          "source": "/pricing",
          "destination": "/pricing/index.html"
        },
        {
          "source": "/legal",
          "destination": "/legal/index.html"
        },
        {
          "source": "/pay",
          "destination": "/pay/index.html"
        },
        {
          "source": "/demo",
          "destination": "/demo/index.html"
        },
        {
          "source": "/demo/((?!assets/).*)",
          "destination": "/demo/index.html"
        },
        {
          "source": "/m",
          "destination": "/m/index.html"
        },
        {
          "source": "/m/(.*)",
          "destination": "/m/index.html"
        }
      ]
    },
    "api": {
      "root": "lead-api",
      "runtime": "python",
      "entrypoint": "vercel_app:app",
      "functions": {
        "vercel_app.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "https://app.warexx.aavoraa.com/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(leads|trial|admin|subscribe|geo)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/oms/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/auth/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/users(/.*)?",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/payment/(return|webhook)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(index.html|landing.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/pricing(/|/index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/legal(/|/index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/pay(/|/index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/pay(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/demo(/|/index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(demo|m)(/.*)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self'; form-action 'self'; base-uri 'self'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/demo/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
